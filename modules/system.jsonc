{
    "group/system": {
	"orientation": "horizontal",
	"drawer": {
	    "transition-duration": 300,
	    "transition-left-to-right": true,
	    "click-to-reveal": true
	},
	"modules": [
	"custom/system-icon",
	"memory",
	"cpu",
	"temperature"
	]
    },

    "custom/system-icon": {
	"format": "󰒋",
	"tooltip": false
    },

    "memory": {
	"interval": 2,
	"format": "  {percentage}%",
	"states": {
	    "warning": 80,
	    "critical": 90
	}
    },

    "cpu": {
	"interval": 2,
	"format": "  {usage}%",
	"states": {
	    "warning": 80,
	    "critical": 90
	}
    },

    "temperature": {
	"interval": 2,
	"hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
	"format": " {temperatureC}°C",
	"states": {
	    "warning": 80,
	    "critical": 90
	}
    }
}
